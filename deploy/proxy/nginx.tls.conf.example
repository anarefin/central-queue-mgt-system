# NFR-SEC-010 (SRS §25.2): "All traffic MUST be TLS 1.2 or higher, including within a site LAN. HTTP MUST NOT be an
# option in production." This is the production variant of nginx.conf: it terminates TLS 1.2+ and redirects any
# plain HTTP to HTTPS. deploy/compose.yaml keeps plain nginx.conf as its default (that is what CI's compose-smoke
# job exercises over plain HTTP, and what a consultant's first local dry run uses before certificates exist) - a
# production install replaces it with this file plus real certificates. See docs/ops/tls-and-kiosk-display-shell.md.
#
# To use: mount a real certificate and key, then point deploy/compose.yaml's `proxy` service at this file instead of
# nginx.conf, e.g.:
#   volumes:
#     - ./proxy/nginx.tls.conf.example:/etc/nginx/conf.d/default.conf:ro
#     - /etc/qms/tls/fullchain.pem:/etc/nginx/tls/fullchain.pem:ro
#     - /etc/qms/tls/privkey.pem:/etc/nginx/tls/privkey.pem:ro
#   ports:
#     - "443:443"

server {
    listen 80;
    server_name _;
    # NFR-SEC-010: HTTP MUST NOT be an option in production - the only thing plain HTTP is allowed to do is redirect.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    # NFR-SEC-010: TLS 1.2 or higher, never lower, even on the site LAN.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:qms_ssl:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    location ~ ^/(admin|console|kiosk|display|visitor)/config\.json$ {
        add_header Cache-Control "no-store";
    }

    location = / {
        return 302 /visitor/;
    }

    location = /api/v1/stream {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Trace-Id $http_x_trace_id;
        proxy_read_timeout 75s;
    }

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Trace-Id $http_x_trace_id;
        proxy_read_timeout 30s;
    }

    location /i18n/ {
        alias /etc/qms/i18n/;
        add_header Cache-Control "no-store";
    }

    location ~ ^/(admin|console|kiosk|display|visitor)(/.*)?$ {
        try_files $uri $uri/ $uri.html /$1/index.html;
    }

    location /_next/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
